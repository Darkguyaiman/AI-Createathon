  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Left side: Challenge panel & grid indicators -->
      <div class="lg:col-span-7 space-y-12 fade-up">
