        <div class="bg-primary brutal-border p-10 text-white brutal-shadow">
          <p class="font-mono text-xl mb-4 uppercase">Top Winner Prize</p>
          <p class="font-heading text-3xl md:text-4xl leading-none font-black mb-6 flex items-center gap-4">
            <img src="/assets/ai-icons/gemini.svg" alt="" class="w-12 h-12 brutal-border-sm bg-white p-2">
            Gemini AI Pro
          </p>
          <div class="h-1 bg-white mb-6"></div>
          <p class="font-sans text-sm font-bold uppercase">All Gemini AI Pro benefits listed below are for the top winner only. 2nd and 3rd place receive hampers only.</p>
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs font-black uppercase">
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">redeem</span>
              Winner Hamper
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">workspace_premium</span>
              Digital Certificate
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">cloud</span>
              5 TB Storage
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">auto_awesome</span>
              Gemini 3.1 Pro
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">group_add</span>
              Share With 5
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">paid</span>
              1,000 AI Credits
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">science</span>
              Flow + Veo 3.1
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">library_books</span>
              NotebookLM
            </div>
            <div class="bg-white text-on-surface brutal-border-sm px-3 py-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-lg">docs</span>
              Workspace AI
            </div>
          </div>
        </div>
        <div class="bg-inverse-surface brutal-border p-10 text-white brutal-shadow">
          <p class="font-mono text-xl mb-4 uppercase">Walk-In Registration</p>
          <p class="font-heading text-4xl leading-tight font-black text-primary">REGISTER ON SITE</p>
          <p class="font-sans text-sm opacity-80 mt-4 leading-relaxed">Come to the event venue and complete registration at the check-in counter before the createathon begins.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- MAIN EVALUATOR SECTION -->
