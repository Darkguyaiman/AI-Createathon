<%- include('partials/header') %>

<!-- HERO SECTION: Google High-Energy Brutalist Layout -->
<section class="relative bg-background overflow-hidden min-h-[90vh] flex items-center py-16 md:py-24" id="hero">
  <div class="diagonal-stripe absolute inset-0 opacity-40"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left: Headline & Actions -->
      <div class="lg:col-span-7 space-y-8 text-left fade-up">
        <div class="flex flex-wrap items-center gap-4">
          <div class="inline-block bg-inverse-surface text-pure-white px-6 py-2 brutal-border font-mono text-sm uppercase tracking-wider">
            8 JULY 2026 10:00 AM
          </div>
          <div class="inline-flex items-center justify-center bg-pure-white text-on-surface px-6 py-3 brutal-border brutal-shadow-sm" aria-label="Malaysia University of Science and Technology">
            <img src="/assets/must.png" alt="Malaysia University of Science and Technology logo" class="w-48 h-20 sm:w-64 sm:h-24 object-contain">
          </div>
        </div>
        
        <h1 class="display-title-stroke font-heading text-6xl md:text-8xl text-on-surface font-black mb-0 uppercase leading-none break-words">
          PROMPT<br/>
          <span class="text-primary">YOUR IDEAS</span>
        </h1>
        
        <p class="font-heading text-headline-lg-mobile md:text-5xl text-on-surface-variant font-black uppercase tracking-tight leading-tight max-w-2xl">
          THE ULTIMATE 3-HOUR AI DEVELOPMENT SPRINT.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 pt-4 items-start sm:items-center">
          <a class="inline-block bg-primary text-on-primary px-10 py-5 font-heading text-xl brutal-border brutal-shadow hover-brutal transition-all uppercase text-center" href="/voting">
            VOTE FOR PROJECTS
          </a>
          
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 brutal-border bg-pure-white flex items-center justify-center text-on-surface">
              <span class="material-symbols-outlined text-3xl">location_on</span>
            </div>
            <p class="font-mono font-bold text-sm leading-tight uppercase">4B1, MUST UNIVERSITY,<br/>MALAYSIA</p>
          </div>
        </div>
      </div>

      <!-- Right: Live Countdown Wrapper -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end fade-up mt-8 lg:mt-0">
        <div class="w-full max-w-md bg-pure-white brutal-border brutal-shadow p-8 text-on-surface relative">
          <div class="absolute -top-6 -right-6 bg-primary text-white p-4 brutal-border font-heading text-2xl rotate-12 uppercase tracking-wide shadow-sm">
            LIVE!
          </div>

          <h3 id="countdown-title" class="text-xs uppercase tracking-widest text-primary font-black font-mono mb-2">Countdown to Kickoff</h3>
          <p id="countdown-message" class="font-heading text-2xl uppercase leading-none font-black text-on-surface">Get ready to prompt.</p>
          
          <!-- Countdown Timer container -->
          <div id="countdown" class="grid grid-cols-4 gap-2.5 text-center my-6 font-mono">
            <div class="bg-background brutal-border-sm p-3 shadow-brutal-sm">
              <span id="days" class="text-3xl font-black text-primary">00</span>
              <p class="text-[9px] uppercase font-bold text-on-surface/70 mt-1">Days</p>
            </div>
            <div class="bg-background brutal-border-sm p-3 shadow-brutal-sm">
              <span id="hours" class="text-3xl font-black text-on-surface">00</span>
              <p class="text-[9px] uppercase font-bold text-on-surface/70 mt-1">Hours</p>
            </div>
            <div class="bg-background brutal-border-sm p-3 shadow-brutal-sm">
              <span id="minutes" class="text-3xl font-black text-on-surface">00</span>
              <p class="text-[9px] uppercase font-bold text-on-surface/70 mt-1">Mins</p>
            </div>
            <div class="bg-background brutal-border-sm p-3 shadow-brutal-sm">
              <span id="seconds" class="text-3xl font-black text-primary">00</span>
              <p class="text-[9px] uppercase font-bold text-on-surface/70 mt-1">Secs</p>
            </div>
          </div>

          <div class="h-1 bg-on-surface/10 my-6"></div>
          
          <div class="space-y-3.5 font-mono text-xs font-bold text-on-surface/80">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-lg">check_box</span>
              <p>RM15 ENTRY FEE</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-lg">check_box</span>
              <p>FREE INTRODUCTION TO AI WORKSHOP</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-lg">check_box</span>
              <p>COMPLIMENTARY SNACKS &amp; REFRESHMENTS</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- MARQUEE SPLITTER -->
<div class="bg-primary text-pure-white py-6 marquee brutal-border border-x-0 z-20 relative">
  <div class="marquee-content gap-12 font-heading">
    <span class="text-6xl uppercase italic font-black">NO PRE-BUILT APPS</span>
    <span class="text-6xl uppercase italic font-black marquee-outline">BUILD LIVE</span>
    <span class="text-6xl uppercase italic font-black">3 HOURS ONLY</span>
    <span class="text-6xl uppercase italic font-black marquee-outline">AI REVOLUTION</span>
    <span class="text-6xl uppercase italic font-black">NO PRE-BUILT APPS</span>
    <span class="text-6xl uppercase italic font-black marquee-outline">BUILD LIVE</span>
    <span class="text-6xl uppercase italic font-black">3 HOURS ONLY</span>
    <span class="text-6xl uppercase italic font-black marquee-outline">AI REVOLUTION</span>
  </div>
</div>

<!-- CHALLENGE DETAIL SECTION -->
