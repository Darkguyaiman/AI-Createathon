        <div class="absolute inset-0 brutal-border border-primary/80 z-[4]"></div>
        <img src="/assets/shape-circle-big.svg" alt="" class="scroll-circle-asset absolute w-[380px] md:w-[480px] max-w-none opacity-80" aria-hidden="true" data-scroll-motion="rotate" loading="lazy" decoding="async">
        <div class="absolute inset-x-8 top-8 h-1 bg-primary z-[5]"></div>
        <div class="absolute inset-x-8 bottom-8 h-1 bg-pure-white/25 z-[5]"></div>
        <div class="absolute left-8 top-8 bottom-8 w-1 bg-pure-white/25 z-[5]"></div>
        <div class="absolute right-8 top-8 bottom-8 w-1 bg-primary z-[5]"></div>
        <p class="absolute bottom-12 left-12 right-12 font-mono text-xs uppercase font-black tracking-widest text-pure-white z-[6]">
          03:00:00 / build window
        </p>
      </div>
    </div>
  </div>
</section>

<!-- DARK VISUAL INTERLUDE: PHOENIX -->
<section class="dark-scroll-section bg-[#0f1510] text-pure-white border-b-8 border-inverse-surface overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-24 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5 order-2 lg:order-1 min-h-[380px] md:min-h-[560px] relative fade-up phoenix-stage">
        <img src="/assets/phoenix.svg" alt="" class="phoenix-asset absolute w-[320px] md:w-[450px] max-w-none" aria-hidden="true" data-scroll-motion="bob" loading="lazy" decoding="async">
        <div class="absolute inset-6 brutal-border border-primary z-[4]"></div>
        <div class="absolute left-0 top-1/2 h-8 w-full -translate-y-1/2 bg-primary/20 z-[1]"></div>
      </div>

      <div class="lg:col-span-7 order-1 lg:order-2 fade-up relative z-10 lg:text-right">
        <p class="font-mono text-xs uppercase font-black tracking-widest text-primary mb-5">From Scratch</p>
        <h2 class="display-title-stroke-light font-heading text-5xl md:text-7xl uppercase leading-none font-black mb-8">
          RISE<br/><span class="text-primary">AND SHIP</span>
        </h2>
        <p class="font-sans text-xl md:text-2xl font-bold leading-tight max-w-2xl lg:ml-auto text-pure-white/85">
