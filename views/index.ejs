<!-- LIVE UPDATE TIMELINE SECTION -->
<section id="updates" class="py-20 bg-background border-b-8 border-inverse-surface scroll-mt-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 space-y-4 fade-up">
      <div class="inline-block bg-primary text-white brutal-border px-4 py-1.5 font-mono text-xs uppercase font-bold tracking-wider">
        Event Feed
      </div>
      <h2 class="font-heading text-5xl md:text-7xl text-on-surface mb-0 uppercase leading-none">
        LIVE<br/><span class="text-primary underline decoration-[8px] underline-offset-[12px]">UPDATES</span>
      </h2>
      <p class="text-on-surface/80 font-mono text-xs max-w-md mx-auto">Follow along with announcements, updates, and photos directly from the organizing committee.</p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative border-l-4 border-inverse-surface ml-4 md:ml-6 space-y-12">
      <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
        <% posts.forEach((post, index) => { %>
          <div class="relative pl-8 md:pl-10 group fade-up">
            <!-- Timeline Node Indicator -->
            <div class="absolute -left-[14px] top-1.5 w-6 h-6 rounded-full bg-primary border-4 border-inverse-surface shadow-brutal-sm group-hover:scale-110 transition-transform"></div>
            
            <!-- Post Card -->
            <div class="brutal-border p-8 bg-pure-white brutal-shadow hover-brutal hover:bg-background transition-colors duration-300">
              <div class="flex items-center justify-between gap-4 mb-4 font-mono text-xs">
                <span class="font-bold text-primary">
                  <i class="fa-solid fa-user-tie mr-1"></i> <%= post.author || 'Organizer' %>
                </span>
                <span class="font-medium text-on-surface/60">
                  <i class="fa-regular fa-clock mr-1"></i> <%= new Date(post.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                </span>
              </div>

              <h3 class="text-2xl font-black font-heading text-on-surface mb-3 uppercase leading-none"><%= post.title %></h3>
              <p class="text-on-surface/90 text-sm leading-relaxed mb-6 whitespace-pre-line font-sans"><%= post.content %></p>
              
              <% if (post.image_path) { %>
                <div class="overflow-hidden brutal-border max-h-96">
                  <img src="<%= post.image_path %>" alt="<%= post.title %>" class="w-full h-full object-cover">
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Empty Timeline State -->
        <div class="relative pl-8 md:pl-10 fade-up">
          <div class="absolute -left-[14px] top-1.5 w-6 h-6 rounded-full bg-pure-white border-4 border-inverse-surface"></div>
          <div class="brutal-border p-8 bg-pure-white brutal-shadow text-center space-y-4">
            <div class="w-12 h-12 brutal-border bg-background flex items-center justify-center text-primary mx-auto">
              <span class="material-symbols-outlined text-3xl animate-pulse">timer</span>
            </div>
            <h3 class="text-xl font-bold uppercase font-heading text-on-surface">The clock is ticking...</h3>
            <p class="text-on-surface/75 font-mono text-xs max-w-sm mx-auto">No timeline updates have been posted yet. Live blogging will start as soon as the hackers begin pitching!</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

