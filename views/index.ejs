        {
          name: 'Gemini',
          maker: 'Google',
          logo: '/assets/ai-icons/gemini.svg',
          tone: 'model-gemini',
          url: 'https://gemini.google.com/',
          summary: 'Useful for research, planning, multimodal prompts, Google ecosystem workflows, and quick drafts.'
        },
        {
          name: 'Claude',
          maker: 'Anthropic',
