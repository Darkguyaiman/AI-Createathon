<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
  <div>
    <p class="font-mono text-xs font-black uppercase tracking-widest text-primary mb-2">Settings & Security</p>
    <h1 class="text-3xl font-extrabold tracking-tight">System Administrators</h1>
    <p class="text-sm text-slate-400 mt-1">Manage administrative accounts, specify roles, and provision credentials.</p>
  </div>
  <a href="/admin/settings/admins/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-bold uppercase tracking-wider border border-slate-800 transition-colors">
    <i class="fa-solid fa-plus"></i> New Administrator
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="w-full bg-slate-950 border border-slate-800 p-6 md:p-8">
  <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
    <i class="fa-solid fa-shield-halved text-accent-teal"></i> Administrator Roster
  </h3>

  <% if (admins && admins.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-slate-900 text-slate-400 uppercase font-bold text-[10px] border-b border-slate-800">
          <tr>
            <th class="py-4 px-4">Username</th>
            <th class="py-4 px-4">Email Address</th>
            <th class="py-4 px-4 text-center">Role Status</th>
            <th class="py-4 px-4 text-center">Registered Date</th>
            <th class="py-4 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-850">
          <% admins.forEach(admin => { %>
            <tr class="hover:bg-slate-900/50 transition-colors">
              <td class="py-4 px-4 font-bold text-white"><%= admin.username %></td>
              <td class="py-4 px-4 text-slate-300"><%= admin.email %></td>
              <td class="py-4 px-4 text-center">
                <% if (admin.role === 'super') { %>
                  <span class="inline-block px-2.5 py-0.5 text-[9px] font-black bg-accent-teal/15 text-accent-teal rounded border border-accent-teal/20 uppercase tracking-widest">Super Admin</span>
                <% } else { %>
                  <span class="inline-block px-2.5 py-0.5 text-[9px] font-black bg-slate-800 text-slate-400 rounded border border-slate-700 uppercase tracking-widest">Normal Admin</span>
                <% } %>
              </td>
              <td class="py-4 px-4 text-center text-slate-400 font-mono text-xs">
                <%= new Date(admin.created_at).toLocaleDateString([], {year: 'numeric', month: 'short', day: 'numeric'}) %>
              </td>
              <td class="py-4 px-4 text-right flex items-center justify-end gap-2">
                <a href="/admin/settings/admins/<%= admin.id %>/edit" class="p-2.5 bg-slate-950 hover:bg-slate-800 hover:text-white text-slate-400 border border-slate-850 transition-colors" aria-label="Edit <%= admin.username %>">
                  <i class="fa-solid fa-pen-to-square text-xs"></i>
                </a>
                <% if (admin.id === session.adminId) { %>
                  <span class="text-[9px] font-bold text-slate-500 uppercase tracking-wider py-2 px-3 bg-slate-900 border border-slate-850 cursor-default">Active</span>
                <% } else { %>
                  <form action="/admin/settings/admins/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete admin account &quot;<%= admin.username %>&quot;?');" class="inline-block">
                    <input type="hidden" name="adminId" value="<%= admin.id %>">
                    <button type="submit" class="inline-flex items-center justify-center p-2.5 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= admin.username %>">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="py-12 text-center max-w-sm mx-auto space-y-4">
      <div class="w-12 h-12 bg-slate-900 text-slate-500 flex items-center justify-center rounded-2xl mx-auto border border-slate-800">
        <i class="fa-solid fa-shield-halved text-lg"></i>
      </div>
      <h3 class="text-sm font-bold text-white">No Administrators Registered</h3>
      <p class="text-xs text-slate-400">Add administrative credentials to allow others to access the system.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
