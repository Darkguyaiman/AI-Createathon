<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-5">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Judges Evaluation & Scoring</h1>
    <p class="text-sm text-slate-400 mt-1">Review formal scores and feedback from panel judges.</p>
  </div>

  <a href="/admin/scores/new<%= typeof selectedGroupId !== 'undefined' && selectedGroupId ? '?groupId=' + selectedGroupId : '' %>" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
    <i class="fa-solid fa-star"></i> Record Score
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="bg-slate-950 border border-slate-800 p-6 md:p-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h3 class="text-md font-bold text-white">Recorded Score Entries (<%= scores.length %>)</h3>
    <a href="/admin/scores/new" class="text-[10px] font-bold text-accent-teal uppercase tracking-wider hover:text-white transition-colors">
      Add Score <i class="fa-solid fa-arrow-right ml-1"></i>
    </a>
  </div>

  <% if (scores.length > 0) { %>
    <div class="space-y-4">
      <% scores.forEach(entry => { %>
        <div class="p-5 bg-slate-900 border border-slate-800">
          <div class="flex items-start justify-between gap-4 mb-3">
            <div>
              <h4 class="font-extrabold text-white text-sm"><i class="fa-solid fa-user-tie text-accent-teal mr-1"></i> <%= entry.judge_name %></h4>
              <p class="text-[10px] text-slate-400">Evaluated: <span class="font-bold text-accent-red"><%= entry.group_name %></span></p>
            </div>

            <form action="/admin/scores/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this scoring evaluation?');">
              <input type="hidden" name="scoreId" value="<%= entry.id %>">
              <button type="submit" class="p-2 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete score by <%= entry.judge_name %>">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center bg-slate-950 py-3 border border-slate-850 my-3">
            <div>
              <p class="text-[9px] uppercase font-bold text-slate-500">Innovation</p>
              <p class="text-sm font-bold text-white"><%= entry.score_innovation %> / 10</p>
            </div>
            <div>
              <p class="text-[9px] uppercase font-bold text-slate-500">Design</p>
              <p class="text-sm font-bold text-white"><%= entry.score_design %> / 10</p>
            </div>
            <div>
              <p class="text-[9px] uppercase font-bold text-slate-500">Execution</p>
              <p class="text-sm font-bold text-white"><%= entry.score_execution %> / 10</p>
            </div>
            <div class="sm:border-l border-slate-800">
              <p class="text-[9px] uppercase font-bold text-accent-teal">Total</p>
              <p class="text-sm font-extrabold text-accent-teal"><%= entry.score_innovation + entry.score_design + entry.score_execution %> / 30</p>
            </div>
          </div>

          <% if (entry.feedback) { %>
            <div class="mt-2 text-xs text-slate-400 italic bg-slate-950/50 p-2.5 border border-slate-850 leading-relaxed">
              "<%= entry.feedback %>"
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="p-12 text-center bg-slate-900 border border-slate-850">
      <div class="w-12 h-12 bg-slate-950 border border-slate-850 flex items-center justify-center text-slate-500 mx-auto mb-4">
        <i class="fa-solid fa-star-half-stroke text-lg"></i>
      </div>
      <p class="text-xs text-slate-400 font-semibold mb-4">No evaluations inputted yet.</p>
      <a href="/admin/scores/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
        <i class="fa-solid fa-star"></i> Record First Score
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
