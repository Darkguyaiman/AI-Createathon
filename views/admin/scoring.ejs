<%- include('../partials/admin-header') %>

<!-- PAGE HEADER -->
<div class="mb-10">
  <h1 class="text-3xl font-extrabold tracking-tight">Judges Evaluation & Scoring</h1>
  <p class="text-sm text-slate-400 mt-1">Record and manage formal scores and feedback from panel judges across evaluation criteria.</p>
</div>

<!-- ALERTS -->
<% if (typeof success_msg !== 'undefined' && success_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= success_msg %></p>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-exclamation text-rose-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= error_msg %></p>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  
  <!-- Score Input Form (Left 5 cols) -->
  <div class="lg:col-span-5 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl h-fit">
    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
      <i class="fa-solid fa-star text-accent-teal"></i> Record Score Entry
    </h3>
    
    <form action="/admin/scores" method="POST" class="space-y-4">
      <div>
        <label for="judgeName" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Judge Name</label>
        <input type="text" id="judgeName" name="judge_name" required placeholder="e.g. Prof. Ismail / Industry Expert A"
               class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>

      <div>
        <label for="scoreGroup" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Evaluate Team</label>
        <select id="scoreGroup" name="group_id" required
                class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
          <option value="">-- Choose Team --</option>
          <% groups.forEach(group => { %>
            <option value="<%= group.id %>" <%= typeof selectedGroupId !== 'undefined' && selectedGroupId == group.id ? 'selected' : '' %>><%= group.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Rubric parameters -->
      <div class="grid grid-cols-3 gap-3 border-t border-slate-900 pt-4">
        <div>
          <label for="scoreInnovation" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Innovation (1-10)</label>
          <input type="number" id="scoreInnovation" name="score_innovation" min="1" max="10" required placeholder="8"
                 class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
        </div>

        <div>
          <label for="scoreDesign" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Design/UX (1-10)</label>
          <input type="number" id="scoreDesign" name="score_design" min="1" max="10" required placeholder="7"
                 class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
        </div>

        <div>
          <label for="scoreExecution" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Execution (1-10)</label>
          <input type="number" id="scoreExecution" name="score_execution" min="1" max="10" required placeholder="9"
                 class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
        </div>
      </div>

      <div>
        <label for="scoreFeedback" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Judges Feedback (Optional)</label>
        <textarea id="scoreFeedback" name="feedback" placeholder="Provide a summary of comments, presentation flaws, or outstanding features..." rows="3"
                  class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all resize-none"></textarea>
      </div>

      <button type="submit" class="w-full mt-4 py-3 px-4 bg-accent-teal hover:bg-teal-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-floppy-disk"></i> Save Evaluation Entry
      </button>
    </form>
  </div>

  <!-- Recorded Scores List (Right 7 cols) -->
  <div class="lg:col-span-7 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl">
    <h3 class="text-md font-bold text-white mb-6">Recorded Score Entries (<%= scores.length %>)</h3>
    
    <% if (scores.length > 0) { %>
      <div class="space-y-4 max-h-[600px] overflow-y-auto pr-2 scrollbar-thin">
        <% scores.forEach(entry => { %>
          <div class="p-5 bg-slate-900 border border-slate-800 rounded-2xl">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h4 class="font-extrabold text-white text-sm"><i class="fa-solid fa-user-tie text-accent-teal mr-1"></i> <%= entry.judge_name %></h4>
                <p class="text-[10px] text-slate-400">Evaluated: <span class="font-bold text-accent-red"><%= entry.group_name %></span></p>
              </div>

              <!-- Delete Score Form -->
              <form action="/admin/scores/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this scoring evaluation?');">
                <input type="hidden" name="scoreId" value="<%= entry.id %>">
                <button type="submit" class="p-2 rounded-lg bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>

            <!-- Score breakdown grid -->
            <div class="grid grid-cols-4 gap-2 text-center bg-slate-950 py-3 rounded-xl border border-slate-850 my-3">
              <div>
                <p class="text-[9px] uppercase font-bold text-slate-500">Innovation</p>
                <p class="text-sm font-bold text-white"><%= entry.score_innovation %> / 10</p>
              </div>
              <div>
                <p class="text-[9px] uppercase font-bold text-slate-500">Design</p>
                <p class="text-sm font-bold text-white"><%= entry.score_design %> / 10</p>
              </div>
              <div>
                <p class="text-[9px] uppercase font-bold text-slate-500">Execution</p>
                <p class="text-sm font-bold text-white"><%= entry.score_execution %> / 10</p>
              </div>
              <div class="border-l border-slate-800">
                <p class="text-[9px] uppercase font-bold text-accent-teal">Total</p>
                <p class="text-sm font-extrabold text-accent-teal"><%= entry.score_innovation + entry.score_design + entry.score_execution %> / 30</p>
              </div>
            </div>

            <% if (entry.feedback) { %>
              <div class="mt-2 text-xs text-slate-400 italic bg-slate-950/50 p-2.5 rounded-lg border border-slate-850 leading-relaxed">
                "<%= entry.feedback %>"
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-12 text-center bg-slate-900 border border-slate-850 rounded-2xl">
        <div class="w-12 h-12 rounded-2xl bg-slate-950 border border-slate-850 flex items-center justify-center text-slate-500 mx-auto mb-4">
          <i class="fa-solid fa-star-half-stroke text-lg"></i>
        </div>
        <p class="text-xs text-slate-400 font-semibold">No evaluations inputted yet. Select a team and submit a score above!</p>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
