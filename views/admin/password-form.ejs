<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
  <div>
    <p class="font-mono text-xs font-black uppercase tracking-widest text-primary mb-2">Security</p>
    <h1 class="text-3xl font-extrabold tracking-tight">Change Admin Password</h1>
    <p class="text-sm text-slate-400 mt-1">Update the credentials for the current admin account.</p>
  </div>
  <a href="/admin/settings" class="inline-flex items-center justify-center gap-2 bg-slate-900 text-slate-300 px-4 py-3 text-xs font-bold uppercase tracking-wider border border-slate-800 transition-colors">
    <i class="fa-solid fa-arrow-left"></i> Back to settings
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="max-w-xl bg-slate-950 border border-slate-800 p-6 md:p-8">
  <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
    <i class="fa-solid fa-shield-halved text-accent-red"></i> Password Details
  </h3>

  <form action="/admin/settings/change-password" method="POST" class="space-y-4">
    <div>
      <label for="oldPassword" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Current Password</label>
      <input type="password" id="oldPassword" name="old_password" required placeholder="Current password"
             class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
    </div>

    <div>
      <label for="newPassword" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">New Password</label>
      <input type="password" id="newPassword" name="new_password" required placeholder="Min 6 characters"
             class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
    </div>

    <div>
      <label for="confirmNewPassword" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Confirm New Password</label>
      <input type="password" id="confirmNewPassword" name="confirm_new_password" required placeholder="Match new password"
             class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
    </div>

    <button type="submit" class="w-full mt-4 py-3.5 px-4 bg-accent-red hover:bg-red-600 text-white font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2">
      <i class="fa-solid fa-key"></i> Update Security Credentials
    </button>
  </form>
</div>

<%- include('../partials/admin-footer') %>
