<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-5">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Timeline Live Blogging</h1>
    <p class="text-sm text-slate-400 mt-1">Manage announcements, session triggers, and event pictures shown on the home page timeline.</p>
  </div>

  <a href="/admin/posts/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
    <i class="fa-solid fa-bullhorn"></i> New Live Post
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="bg-slate-950 border border-slate-800 p-6 md:p-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h3 class="text-md font-bold text-white">Published Updates (<%= posts.length %>)</h3>
    <a href="/admin/posts/new" class="text-[10px] font-bold text-accent-teal uppercase tracking-wider hover:text-white transition-colors">
      Create Update <i class="fa-solid fa-arrow-right ml-1"></i>
    </a>
  </div>

  <% if (posts.length > 0) { %>
    <div class="space-y-6">
      <% posts.forEach(post => { %>
        <div class="p-5 bg-slate-900 border border-slate-800 flex flex-col justify-between gap-4">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <span class="text-[9px] uppercase font-bold text-accent-teal tracking-wider">
                <i class="fa-solid fa-clock mr-1"></i> <%= new Date(post.created_at).toLocaleString() %>
              </span>
              <h4 class="font-extrabold text-white text-base mt-1"><%= post.title %></h4>
              <p class="text-xs text-slate-300 mt-2 whitespace-pre-line leading-relaxed"><%= post.content %></p>
            </div>

            <div class="flex items-center gap-2">
              <a href="/admin/posts/<%= post.id %>/edit" class="p-2 bg-slate-950 hover:bg-slate-800 hover:text-white text-slate-400 border border-slate-850 transition-colors" aria-label="Edit <%= post.title %>">
                <i class="fa-solid fa-pen-to-square text-xs"></i>
              </a>
              <form action="/admin/posts/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this live update?');">
                <input type="hidden" name="postId" value="<%= post.id %>">
                <button type="submit" class="p-2 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= post.title %>">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>
          </div>

          <% if (post.image_path) { %>
            <div class="border border-slate-850 bg-slate-950 mt-2">
              <button type="button" class="block w-full cursor-zoom-in" data-post-image-open data-image-src="<%= post.image_path %>" data-image-title="<%= post.title %>" aria-label="Open full image for <%= post.title %>">
                <img src="<%= post.image_path %>" alt="" class="w-full h-auto object-contain" style="max-height: 420px;">
              </button>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="p-12 text-center bg-slate-900 border border-slate-850">
      <div class="w-12 h-12 bg-slate-950 border border-slate-850 flex items-center justify-center text-slate-500 mx-auto mb-4">
        <i class="fa-solid fa-timeline text-lg"></i>
      </div>
      <p class="text-xs text-slate-400 font-semibold mb-4">No updates published yet.</p>
      <a href="/admin/posts/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
        <i class="fa-solid fa-bullhorn"></i> Draft First Post
      </a>
    </div>
  <% } %>
</div>

<dialog class="bg-slate-950 text-white border border-slate-700 p-0 w-full" style="width: min(92vw, 1040px); max-height: 90vh;" data-post-image-modal>
  <div class="flex items-center justify-between gap-4 border-b border-slate-800 px-4 py-3">
    <h3 class="text-sm font-extrabold truncate" data-post-image-title>Image preview</h3>
    <button type="button" class="w-10 h-10 bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 transition-colors grid place-items-center" data-post-image-close aria-label="Close image preview">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <div class="bg-slate-950 p-4">
    <img src="" alt="" class="mx-auto max-w-full h-auto object-contain" style="max-height: 76vh;" data-post-image-preview>
  </div>
</dialog>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.querySelector('[data-post-image-modal]');
    const preview = document.querySelector('[data-post-image-preview]');
    const title = document.querySelector('[data-post-image-title]');
    const closeButton = document.querySelector('[data-post-image-close]');

    document.querySelectorAll('[data-post-image-open]').forEach(button => {
      button.addEventListener('click', () => {
        if (!modal?.showModal || !preview) return;
        preview.src = button.dataset.imageSrc || '';
        preview.alt = button.dataset.imageTitle || 'Post image preview';
        if (title) title.textContent = button.dataset.imageTitle || 'Image preview';
        modal.showModal();
      });
    });

    closeButton?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', event => {
      if (event.target === modal) modal.close();
    });
  });
</script>

<%- include('../partials/admin-footer') %>
