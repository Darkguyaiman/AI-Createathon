<%- include('../partials/admin-header') %>

<!-- PAGE HEADER -->
<div class="mb-10">
  <h1 class="text-3xl font-extrabold tracking-tight">Timeline Live Blogging</h1>
  <p class="text-sm text-slate-400 mt-1">Publish live announcements, session triggers, and event pictures directly to the home page timeline feed.</p>
</div>

<!-- ALERTS -->
<% if (typeof success_msg !== 'undefined' && success_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= success_msg %></p>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-exclamation text-rose-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= error_msg %></p>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  
  <!-- Add Post Form (Left 5 cols) -->
  <div class="lg:col-span-5 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl h-fit">
    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
      <i class="fa-solid fa-square-rss text-accent-teal"></i> Create Live Feed Post
    </h3>
    
    <form action="/admin/posts" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label for="postTitle" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Headline / Title</label>
        <input type="text" id="postTitle" name="title" required placeholder="e.g. Hackathon Kickoff! 🚀"
               class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>

      <div>
        <label for="postContent" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Body Content</label>
        <textarea id="postContent" name="content" required placeholder="Write update text details..." rows="6"
                  class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all resize-none"></textarea>
      </div>

      <div>
        <label for="postImage" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Attach Event Image</label>
        <input type="file" id="postImage" name="image" accept="image/*"
               class="block w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-slate-200 hover:file:bg-slate-800 file:cursor-pointer">
      </div>

      <button type="submit" class="w-full mt-4 py-3.5 px-4 bg-accent-teal hover:bg-teal-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-bullhorn"></i> Publish Live Post
      </button>
    </form>
  </div>

  <!-- List of Published Posts (Right 7 cols) -->
  <div class="lg:col-span-7 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl">
    <h3 class="text-md font-bold text-white mb-6">Published Updates (<%= posts.length %>)</h3>
    
    <% if (posts.length > 0) { %>
      <div class="space-y-6 max-h-[600px] overflow-y-auto pr-2 scrollbar-thin">
        <% posts.forEach(post => { %>
          <div class="p-5 bg-slate-900 border border-slate-800 rounded-2xl flex flex-col justify-between gap-4">
            
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="text-[9px] uppercase font-bold text-accent-teal tracking-wider"><i class="fa-solid fa-clock mr-1"></i> <%= new Date(post.created_at).toLocaleString() %></span>
                <h4 class="font-extrabold text-white text-base mt-1"><%= post.title %></h4>
                <p class="text-xs text-slate-300 mt-2 whitespace-pre-line leading-relaxed"><%= post.content %></p>
              </div>

              <!-- Delete Form -->
              <form action="/admin/posts/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this live update?');">
                <input type="hidden" name="postId" value="<%= post.id %>">
                <button type="submit" class="p-2 rounded-lg bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>

            <% if (post.image_path) { %>
              <div class="rounded-xl overflow-hidden border border-slate-850 max-h-48 mt-2">
                <img src="<%= post.image_path %>" alt="" class="w-full h-full object-cover">
              </div>
            <% } %>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-12 text-center bg-slate-900 border border-slate-850 rounded-2xl">
        <div class="w-12 h-12 rounded-2xl bg-slate-950 border border-slate-850 flex items-center justify-center text-slate-500 mx-auto mb-4">
          <i class="fa-solid fa-timeline text-lg"></i>
        </div>
        <p class="text-xs text-slate-400 font-semibold">No updates published. Draft your first live blog using the form on the left!</p>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
