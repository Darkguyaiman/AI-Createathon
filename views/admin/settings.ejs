<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-5">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">System Settings & Controls</h1>
    <p class="text-sm text-slate-400 mt-1">Configure event management flags, reset public voting data, and manage security.</p>
  </div>

  <a href="/admin/settings/password" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
    <i class="fa-solid fa-key"></i> Change Password
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  <div class="space-y-8">
    <div class="bg-slate-950 border border-slate-800 p-6 md:p-8">
      <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <i class="fa-solid fa-sliders text-accent-teal"></i> Public Voting Controls
      </h3>

      <p class="text-xs text-slate-400 leading-relaxed mb-6">
        Open or close public Choice voting page submissions. When open, visitors can choose their team.
      </p>

      <form action="/admin/settings/toggle-voting" method="POST" class="flex flex-col sm:flex-row sm:items-center gap-4">
        <span class="text-sm font-semibold text-slate-300">Current Status:</span>
        <% if (votingActive) { %>
          <span class="px-2.5 py-1 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold text-xs uppercase tracking-wider animate-pulse">Voting Open</span>
          <button type="submit" class="sm:ml-auto py-2.5 px-4 bg-slate-850 hover:bg-slate-800 text-slate-300 font-bold text-xs uppercase transition-colors">
            <i class="fa-solid fa-circle-pause mr-1"></i> Close Voting
          </button>
        <% } else { %>
          <span class="px-2.5 py-1 bg-slate-800 border border-slate-700 text-slate-400 font-bold text-xs uppercase tracking-wider">Voting Closed</span>
          <button type="submit" class="sm:ml-auto py-2.5 px-4 bg-accent-teal hover:bg-teal-400 text-slate-950 font-bold text-xs uppercase transition-all">
            <i class="fa-solid fa-circle-play mr-1"></i> Open Voting
          </button>
        <% } %>
      </form>
    </div>

    <% if (typeof session !== 'undefined' && session.role === 'super') { %>
      <div class="bg-slate-950 border border-slate-800 p-6 md:p-8">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2 text-rose-500">
          <i class="fa-solid fa-triangle-exclamation"></i> Danger Zone
        </h3>
  
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          Reset live public Choice votes. This permanently removes all cast IP-address votes in the database.
        </p>
  
        <form action="/admin/settings/reset-votes" method="POST" onsubmit="return confirm('WARNING: Are you absolutely sure you want to delete ALL live public votes? This action is permanent and cannot be undone.');">
          <button type="submit" class="w-full py-3 bg-slate-950 hover:bg-rose-950 text-rose-500 hover:text-rose-400 font-extrabold text-xs uppercase tracking-wider border border-rose-950 hover:border-rose-900 transition-all">
            <i class="fa-solid fa-trash-can mr-1.5"></i> Delete All Public Votes
          </button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="bg-slate-950 border border-slate-800 p-6 md:p-8 h-fit">
    <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-accent-red"></i> Security
    </h3>
    <p class="text-xs text-slate-400 leading-relaxed mb-6">
      Password updates now happen on a focused page so the settings overview stays reserved for operational controls.
    </p>
    <a href="/admin/settings/password" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
      <i class="fa-solid fa-key"></i> Open Password Form
    </a>
  </div>
</div>

<%- include('../partials/admin-footer') %>
