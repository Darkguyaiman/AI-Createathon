<%- include('../partials/admin-header') %>
<% const isEditing = typeof score !== 'undefined' && score; %>

<div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
  <div>
    <p class="font-mono text-xs font-black uppercase tracking-widest text-primary mb-2">Judges</p>
    <h1 class="text-3xl font-extrabold tracking-tight"><%= isEditing ? 'Edit Score Entry' : 'Record Score Entry' %></h1>
    <p class="text-sm text-slate-400 mt-1"><%= isEditing ? 'Update a judge evaluation for a team.' : 'Submit or update a judge evaluation for a team.' %></p>
  </div>
  <a href="/admin/scoring" class="inline-flex items-center justify-center gap-2 bg-slate-900 text-slate-300 px-4 py-3 text-xs font-bold uppercase tracking-wider border border-slate-800 transition-colors">
    <i class="fa-solid fa-arrow-left"></i> Back to scoring
  </a>
</div>

<%- include('../partials/admin-alerts') %>

<div class="w-full bg-slate-950 border border-slate-800 p-6 md:p-8">
  <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
    <i class="fa-solid fa-star text-accent-teal"></i> Evaluation Details
  </h3>

  <form action="<%= isEditing ? '/admin/scores/' + score.id + '/edit' : '/admin/scores' %>" method="POST" class="space-y-4">
    <div>
      <label for="judgeName" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Judge Name</label>
      <input type="text" id="judgeName" name="judge_name" required placeholder="e.g. Prof. Ismail / Industry Expert A" value="<%= isEditing ? score.judge_name : 'Prof. Khashayar Yazdani' %>"
             class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
    </div>

    <div>
      <label for="scoreGroup" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Evaluate Team</label>
      <select id="scoreGroup" name="group_id" required
              class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
        <option value="">-- Choose Team --</option>
        <% groups.forEach(group => { %>
          <option value="<%= group.id %>" <%= (isEditing && score.group_id == group.id) || (typeof selectedGroupId !== 'undefined' && selectedGroupId == group.id) ? 'selected' : '' %>><%= group.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-900 pt-4">
      <div>
        <label for="scoreInnovation" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Innovation (1-10)</label>
        <input type="number" id="scoreInnovation" name="score_innovation" min="1" max="10" required placeholder="8" value="<%= isEditing ? score.score_innovation : '' %>"
               class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>

      <div>
        <label for="scoreDesign" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Design/UX (1-10)</label>
        <input type="number" id="scoreDesign" name="score_design" min="1" max="10" required placeholder="7" value="<%= isEditing ? score.score_design : '' %>"
               class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>

      <div>
        <label for="scoreExecution" class="block text-[10px] uppercase font-extrabold tracking-wider text-slate-400 mb-1.5 text-center">Execution (1-10)</label>
        <input type="number" id="scoreExecution" name="score_execution" min="1" max="10" required placeholder="9" value="<%= isEditing ? score.score_execution : '' %>"
               class="block w-full px-3 py-2.5 bg-slate-900 border border-slate-800 text-white text-center text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>
    </div>

    <div>
      <label for="scoreFeedback" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Judges Feedback (Optional)</label>
      <textarea id="scoreFeedback" name="feedback" placeholder="Provide a summary of comments, presentation flaws, or outstanding features..." rows="4"
                class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all resize-none"><%= isEditing ? (score.feedback || '') : '' %></textarea>
    </div>

    <button type="submit" class="w-full mt-4 py-3 px-4 bg-accent-teal hover:bg-teal-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2">
      <i class="fa-solid fa-floppy-disk"></i> <%= isEditing ? 'Update Evaluation Entry' : 'Save Evaluation Entry' %>
    </button>
  </form>
</div>

<%- include('../partials/admin-footer') %>
