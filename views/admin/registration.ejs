<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col xl:flex-row xl:items-end justify-between gap-5">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Participant & Team Registration</h1>
    <p class="text-sm text-slate-400 mt-1">Manage project groups and participant roster details.</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-3">
    <a href="/admin/groups/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
      <i class="fa-solid fa-plus"></i> New Team
    </a>
    <a href="/admin/participants/new" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
      <i class="fa-solid fa-user-plus"></i> New Participant
    </a>
  </div>
</div>

<%- include('../partials/admin-alerts') %>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <div class="lg:col-span-6 bg-slate-950 border border-slate-800 p-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h3 class="text-md font-bold text-white">Registered Teams (<%= groups.length %>)</h3>
      <a href="/admin/groups/new" class="text-[10px] font-bold text-accent-teal uppercase tracking-wider hover:text-white transition-colors">
        Add Team <i class="fa-solid fa-arrow-right ml-1"></i>
      </a>
    </div>

    <% if (groups.length > 0) { %>
      <div class="space-y-4 max-h-[620px] overflow-y-auto pr-2 scrollbar-thin">
        <% groups.forEach(group => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= group.logo_path %>" alt="" class="w-12 h-12 object-cover border border-slate-800">
              <div class="min-w-0">
                <h4 class="font-bold text-white text-sm truncate"><%= group.name %></h4>
                <p class="text-[10px] text-slate-400 line-clamp-1"><%= group.description || 'No description available' %></p>
              </div>
            </div>

            <form action="/admin/groups/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this group? This will unlink all members.');">
              <input type="hidden" name="groupId" value="<%= group.id %>">
              <button type="submit" class="p-2.5 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= group.name %>">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850">
        <p class="text-xs text-slate-500 mb-4">No teams created yet.</p>
        <a href="/admin/groups/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
          <i class="fa-solid fa-plus"></i> Create First Team
        </a>
      </div>
    <% } %>
  </div>

  <div class="lg:col-span-6 bg-slate-950 border border-slate-800 p-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h3 class="text-md font-bold text-white">Registered Participants (<%= participants.length %>)</h3>
      <a href="/admin/participants/new" class="text-[10px] font-bold text-accent-red uppercase tracking-wider hover:text-white transition-colors">
        Add Participant <i class="fa-solid fa-arrow-right ml-1"></i>
      </a>
    </div>

    <% if (participants.length > 0) { %>
      <div class="space-y-4 max-h-[620px] overflow-y-auto pr-2 scrollbar-thin">
        <% participants.forEach(p => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= p.avatar_path %>" alt="" class="w-10 h-10 object-cover border border-slate-800">
              <div class="min-w-0">
                <h4 class="font-bold text-white text-sm truncate"><%= p.name %></h4>
                <p class="text-[10px] text-slate-400 truncate"><%= p.email %></p>
                <% if (p.group_name) { %>
                  <span class="inline-block mt-1 text-[9px] font-bold text-accent-teal bg-accent-teal/5 border border-accent-teal/10 px-2 py-0.5"><%= p.group_name %></span>
                <% } else { %>
                  <span class="inline-block mt-1 text-[9px] text-slate-500 italic">Unassigned</span>
                <% } %>
              </div>
            </div>

            <form action="/admin/participants/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this participant?');">
              <input type="hidden" name="participantId" value="<%= p.id %>">
              <button type="submit" class="p-2.5 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= p.name %>">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850">
        <p class="text-xs text-slate-500 mb-4">No participants registered yet.</p>
        <a href="/admin/participants/new" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
          <i class="fa-solid fa-user-plus"></i> Register First Participant
        </a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/admin-footer') %>
