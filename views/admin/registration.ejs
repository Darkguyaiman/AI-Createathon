<%- include('../partials/admin-header') %>

<!-- PAGE HEADER -->
<div class="mb-10">
  <h1 class="text-3xl font-extrabold tracking-tight">Participant & Team Registration</h1>
  <p class="text-sm text-slate-400 mt-1">Register new participants, construct project groups, and manage team roster details.</p>
</div>

<!-- ALERTS -->
<% if (typeof success_msg !== 'undefined' && success_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= success_msg %></p>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg) { %>
  <div class="mb-8 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center gap-3">
    <i class="fa-solid fa-circle-exclamation text-rose-500 text-lg"></i>
    <p class="text-xs font-semibold"><%= error_msg %></p>
  </div>
<% } %>

<!-- FORMS GRID (Side by side for laptop screens) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
  
  <!-- Team/Group Form (Left 5 cols) -->
  <div class="lg:col-span-5 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl h-fit">
    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
      <i class="fa-solid fa-people-group text-accent-teal"></i> Create New Team / Group
    </h3>
    
    <form action="/admin/groups" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label for="groupName" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Team Name</label>
        <input type="text" id="groupName" name="name" required placeholder="e.g. Prompt Engineers"
               class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all">
      </div>

      <div>
        <label for="groupDescription" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Project Description</label>
        <textarea id="groupDescription" name="description" placeholder="Briefly describe the AI project they are creating..." rows="3"
                  class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-teal/35 focus:border-accent-teal transition-all resize-none"></textarea>
      </div>

      <div>
        <label for="groupLogo" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Team Logo / Picture</label>
        <div class="flex items-center gap-3">
          <input type="file" id="groupLogo" name="logo" accept="image/*"
                 class="block w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-slate-200 hover:file:bg-slate-800 file:cursor-pointer">
        </div>
      </div>

      <button type="submit" class="w-full mt-4 py-3 px-4 bg-accent-teal hover:bg-teal-400 text-slate-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-plus"></i> Save Team
      </button>
    </form>
  </div>

  <!-- Participant Form (Right 7 cols) -->
  <div class="lg:col-span-7 bg-slate-950 border border-slate-800 p-6 md:p-8 rounded-3xl h-fit">
    <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
      <i class="fa-solid fa-user-plus text-accent-red"></i> Register New Participant
    </h3>
    
    <form action="/admin/participants" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="memberName" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Full Name</label>
          <input type="text" id="memberName" name="name" required placeholder="e.g. John Doe"
                 class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
        </div>

        <div>
          <label for="memberEmail" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Email Address</label>
          <input type="email" id="memberEmail" name="email" required placeholder="e.g. john@must.edu.my"
                 class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="memberGroup" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Assign to Team</label>
          <select id="memberGroup" name="groupId"
                  class="block w-full px-4 py-3 bg-slate-900 border border-slate-800 text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-red/35 focus:border-accent-red transition-all">
            <option value="">-- Select Team (Optional) --</option>
            <% groups.forEach(group => { %>
              <option value="<%= group.id %>"><%= group.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="memberAvatar" class="block text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-2">Profile Picture / Avatar</label>
          <input type="file" id="memberAvatar" name="avatar" accept="image/*"
                 class="block w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-slate-200 hover:file:bg-slate-800 file:cursor-pointer">
        </div>
      </div>

      <button type="submit" class="w-full mt-4 py-3 px-4 bg-accent-red hover:bg-red-600 text-white font-extrabold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-accent-red/10">
        <i class="fa-solid fa-user-plus"></i> Register & Link Participant
      </button>
    </form>
  </div>

</div>

<!-- DATA LISTINGS (Manage section) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

  <!-- List of Teams (Left 6 cols) -->
  <div class="lg:col-span-6 bg-slate-950 border border-slate-800 p-6 rounded-3xl">
    <h3 class="text-md font-bold text-white mb-6">Registered Teams (<%= groups.length %>)</h3>
    
    <% if (groups.length > 0) { %>
      <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin">
        <% groups.forEach(group => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <img src="<%= group.logo_path %>" alt="" class="w-12 h-12 rounded-xl object-cover border border-slate-800">
              <div>
                <h4 class="font-bold text-white text-sm"><%= group.name %></h4>
                <p class="text-[10px] text-slate-400 line-clamp-1"><%= group.description || 'No description available' %></p>
              </div>
            </div>

            <!-- Delete Form -->
            <form action="/admin/groups/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this group? This will unlink all members.');">
              <input type="hidden" name="groupId" value="<%= group.id %>">
              <button type="submit" class="p-2.5 rounded-lg bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850 rounded-2xl">
        <p class="text-xs text-slate-500">No teams created. Use the form above to add teams.</p>
      </div>
    <% } %>
  </div>

  <!-- List of Participants (Right 6 cols) -->
  <div class="lg:col-span-6 bg-slate-950 border border-slate-800 p-6 rounded-3xl">
    <h3 class="text-md font-bold text-white mb-6">Registered Participants (<%= participants.length %>)</h3>
    
    <% if (participants.length > 0) { %>
      <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin">
        <% participants.forEach(p => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <img src="<%= p.avatar_path %>" alt="" class="w-10 h-10 rounded-full object-cover border border-slate-800">
              <div>
                <h4 class="font-bold text-white text-sm"><%= p.name %></h4>
                <p class="text-[10px] text-slate-400"><%= p.email %></p>
                <% if (p.group_name) { %>
                  <span class="inline-block mt-1 text-[9px] font-bold text-accent-teal bg-accent-teal/5 border border-accent-teal/10 px-2 py-0.5 rounded"><%= p.group_name %></span>
                <% } else { %>
                  <span class="inline-block mt-1 text-[9px] text-slate-500 italic">Unassigned</span>
                <% } %>
              </div>
            </div>

            <!-- Delete Form -->
            <form action="/admin/participants/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this participant?');">
              <input type="hidden" name="participantId" value="<%= p.id %>">
              <button type="submit" class="p-2.5 rounded-lg bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850 rounded-2xl">
        <p class="text-xs text-slate-500">No participants registered. Use the form above to register hackers.</p>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
