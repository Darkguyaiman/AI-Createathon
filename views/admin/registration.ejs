<%- include('../partials/admin-header') %>

<div class="mb-8 flex flex-col xl:flex-row xl:items-end justify-between gap-5">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Participant & Team Registration</h1>
    <p class="text-sm text-slate-400 mt-1">Manage project groups and participant roster details.</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-3">
    <% if (typeof session !== 'undefined' && session.role === 'super') { %>
      <a href="/admin/registration/attendance-export" class="admin-export-button inline-flex items-center justify-center gap-2 bg-green-500 text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
        <i class="fa-solid fa-file-excel"></i> Excel Attendance
      </a>
    <% } %>
    <a href="/admin/groups/new" id="newTeamBtn" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
      <i class="fa-solid fa-plus"></i> New Team
    </a>
    <a href="/admin/participants/new" id="newParticipantBtn" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all hidden">
      <i class="fa-solid fa-user-plus"></i> New Participant
    </a>
  </div>
</div>

<%- include('../partials/admin-alerts') %>

<div class="bg-slate-950 border border-slate-800 p-2">
  <div class="grid grid-cols-2 gap-2 font-mono text-xs font-black uppercase" role="tablist" aria-label="Registration lists">
    <button type="button" class="registration-tab bg-accent-teal text-slate-950 px-4 py-3 border border-slate-800 transition-colors flex items-center justify-center gap-2" data-registration-tab="teams" role="tab" aria-selected="true" aria-controls="registration-panel-teams">
      <i class="fa-solid fa-people-group"></i> Teams
      <span class="text-[10px] opacity-80">(<%= groups.length %>)</span>
    </button>
    <button type="button" class="registration-tab bg-slate-900 text-slate-300 px-4 py-3 border border-slate-800 transition-colors flex items-center justify-center gap-2 hover:text-white" data-registration-tab="participants" role="tab" aria-selected="false" aria-controls="registration-panel-participants">
      <i class="fa-solid fa-users"></i> Participants
      <span class="text-[10px] opacity-80">(<%= participants.length %>)</span>
    </button>
  </div>
</div>

<div class="mt-6">
  <section id="registration-panel-teams" data-registration-panel="teams" role="tabpanel">
  <div class="bg-slate-950 border border-slate-800 p-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h3 class="text-md font-bold text-white">Registered Teams (<%= groups.length %>)</h3>
      <a href="/admin/groups/new" class="text-[10px] font-bold text-accent-teal uppercase tracking-wider hover:text-white transition-colors">
        Add Team <i class="fa-solid fa-arrow-right ml-1"></i>
      </a>
    </div>

    <% if (groups.length > 0) { %>
      <div class="space-y-4 max-h-[620px] overflow-y-auto pr-2 scrollbar-thin">
        <% groups.forEach(group => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= group.logo_path %>" alt="" class="w-12 h-12 object-cover border border-slate-800">
              <div class="min-w-0">
                <h4 class="font-bold text-white text-sm truncate"><%= group.name %></h4>
                <p class="text-[10px] text-slate-400 line-clamp-1"><%= group.description || 'No description available' %></p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <a href="/admin/groups/<%= group.id %>/edit" class="p-2.5 bg-slate-950 hover:bg-slate-800 hover:text-white text-slate-400 border border-slate-850 transition-colors" aria-label="Edit <%= group.name %>">
                <i class="fa-solid fa-pen-to-square text-xs"></i>
              </a>
              <form action="/admin/groups/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this group? This will unlink all members.');">
                <input type="hidden" name="groupId" value="<%= group.id %>">
                <button type="submit" class="p-2.5 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= group.name %>">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850">
        <p class="text-xs text-slate-500 mb-4">No teams created yet.</p>
        <a href="/admin/groups/new" class="inline-flex items-center justify-center gap-2 bg-accent-teal text-slate-950 px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
          <i class="fa-solid fa-plus"></i> Create First Team
        </a>
      </div>
    <% } %>
  </div>
  </section>

  <section id="registration-panel-participants" data-registration-panel="participants" role="tabpanel" hidden>
  <div class="bg-slate-950 border border-slate-800 p-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <h3 class="text-md font-bold text-white">Registered Participants (<%= participants.length %>)</h3>
      <a href="/admin/participants/new" class="text-[10px] font-bold text-accent-red uppercase tracking-wider hover:text-white transition-colors">
        Add Participant <i class="fa-solid fa-arrow-right ml-1"></i>
      </a>
    </div>

    <% if (participants.length > 0) { %>
      <div class="space-y-4 max-h-[620px] overflow-y-auto pr-2 scrollbar-thin">
        <% participants.forEach(p => { %>
          <div class="p-4 bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= p.avatar_path %>" alt="" class="w-10 h-10 object-cover border border-slate-800">
              <div class="min-w-0">
                <h4 class="font-bold text-white text-sm truncate"><%= p.name %></h4>
                <p class="text-[10px] text-slate-400 truncate"><%= p.student_id %></p>
                <% if (p.group_name) { %>
                  <span class="inline-block mt-1 text-[9px] font-bold text-accent-teal bg-accent-teal/5 border border-accent-teal/10 px-2 py-0.5"><%= p.group_name %></span>
                <% } else { %>
                  <span class="inline-block mt-1 text-[9px] text-slate-500 italic">Unassigned</span>
                <% } %>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <a href="/admin/participants/<%= p.id %>/edit" class="p-2.5 bg-slate-950 hover:bg-slate-800 hover:text-white text-slate-400 border border-slate-850 transition-colors" aria-label="Edit <%= p.name %>">
                <i class="fa-solid fa-pen-to-square text-xs"></i>
              </a>
              <form action="/admin/participants/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this participant?');">
                <input type="hidden" name="participantId" value="<%= p.id %>">
                <button type="submit" class="p-2.5 bg-slate-950 hover:bg-rose-950 hover:text-rose-500 text-slate-400 border border-slate-850 hover:border-rose-900 transition-colors" aria-label="Delete <%= p.name %>">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center bg-slate-900 border border-slate-850">
        <p class="text-xs text-slate-500 mb-4">No participants registered yet.</p>
        <a href="/admin/participants/new" class="inline-flex items-center justify-center gap-2 bg-accent-red text-white px-4 py-3 text-xs font-extrabold uppercase tracking-wider border border-slate-800 transition-all">
          <i class="fa-solid fa-user-plus"></i> Register First Participant
        </a>
      </div>
    <% } %>
  </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = Array.from(document.querySelectorAll('[data-registration-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-registration-panel]'));
    const newTeamBtn = document.getElementById('newTeamBtn');
    const newParticipantBtn = document.getElementById('newParticipantBtn');
 
    const setActiveTab = (target) => {
      tabs.forEach(tab => {
        const isActive = tab.dataset.registrationTab === target;
        tab.setAttribute('aria-selected', String(isActive));
        tab.classList.toggle('bg-accent-teal', isActive && target === 'teams');
        tab.classList.toggle('bg-accent-red', isActive && target === 'participants');
        tab.classList.toggle('text-slate-950', isActive && target === 'teams');
        tab.classList.toggle('text-white', isActive && target === 'participants');
        tab.classList.toggle('bg-slate-900', !isActive);
        tab.classList.toggle('text-slate-300', !isActive);
        tab.classList.toggle('hover:text-white', !isActive);
      });
 
      panels.forEach(panel => {
        panel.hidden = panel.dataset.registrationPanel !== target;
      });

      if (newTeamBtn && newParticipantBtn) {
        if (target === 'teams') {
          newTeamBtn.classList.remove('hidden');
          newTeamBtn.classList.add('inline-flex');
          newParticipantBtn.classList.add('hidden');
          newParticipantBtn.classList.remove('inline-flex');
        } else {
          newTeamBtn.classList.add('hidden');
          newTeamBtn.classList.remove('inline-flex');
          newParticipantBtn.classList.remove('hidden');
          newParticipantBtn.classList.add('inline-flex');
        }
      }
    };
 
    tabs.forEach(tab => {
      tab.addEventListener('click', () => setActiveTab(tab.dataset.registrationTab));
    });

    // Explicitly initialize state on page load
    setActiveTab('teams');
  });
</script>

<%- include('../partials/admin-footer') %>
