<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
  <% teamMembers.forEach(member => { %>
    <article class="team-card brutal-border brutal-shadow bg-pure-white p-5 min-h-[220px] fade-up group">
      <div class="team-signature" aria-hidden="true">
        <% (member.signatureName || member.name).split(' ').forEach(word => { %>
          <span><%= word %></span>
        <% }) %>
      </div>

      <div class="team-card-copy">
        <p class="font-mono text-[10px] uppercase font-black text-primary mb-3 tracking-widest team-card-kicker"><%= member.studentId %></p>
        <h3 class="font-heading font-black text-lg text-on-surface uppercase leading-tight mb-3 team-card-name"><%= member.name %></h3>
        <p class="text-xs uppercase font-black text-primary font-mono leading-relaxed team-card-role"><%= member.role %></p>
      </div>

      <div class="team-photo brutal-border bg-background overflow-hidden">
        <% if (member.image) { %>
          <img src="<%= member.image %>" alt="<%= member.name %>" class="w-full h-full object-cover" loading="lazy" decoding="async">
        <% } else { %>
          <div class="team-placeholder" aria-label="<%= member.name %> photo placeholder">
            <span class="material-symbols-outlined">person</span>
          </div>
        <% } %>
      </div>
    </article>
  <% }) %>
</div>
