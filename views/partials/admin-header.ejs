<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Admin Panel' : 'Admin Panel | AI Createathon 2026' %></title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <link rel="stylesheet" href="/vendor/google-fonts/fonts.css">

  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
</head>
<body class="admin-app min-h-screen bg-background text-on-surface font-sans selection:bg-primary selection:text-white">
  <div class="min-h-screen lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
    <aside class="admin-sidebar bg-inverse-surface text-pure-white lg:sticky lg:top-0 lg:h-screen lg:border-r-4 border-primary">
      <div class="flex h-full flex-col">
        <div class="p-5 lg:p-6 border-b-4 border-primary">
          <a href="/" class="flex items-center gap-3 group" aria-label="AI Createathon home">
            <span class="grid h-12 w-12 place-items-center bg-primary text-white brutal-border-sm group-hover:rotate-6 transition-transform">
              <span class="material-symbols-outlined text-3xl">smart_toy</span>
            </span>
            <span class="min-w-0">
              <span class="block font-heading text-xl font-black uppercase leading-none">AI-<span class="text-primary">Createathon</span></span>
              <span class="block font-mono text-[10px] font-black uppercase tracking-widest text-pure-white/70 mt-1">Admin Control</span>
            </span>
          </a>
        </div>

        <nav class="admin-nav grid gap-2 p-4 lg:p-5 font-mono text-xs font-black uppercase" aria-label="Admin navigation">
          <a href="/admin/dashboard" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'is-active' : '' %>">
            <span class="material-symbols-outlined">dashboard</span>
            Dashboard
          </a>
          <a href="/admin/registration" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'registration' ? 'is-active' : '' %>">
            <span class="material-symbols-outlined">groups</span>
            Registration
          </a>
          <a href="/admin/posts" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'posts' ? 'is-active' : '' %>">
            <span class="material-symbols-outlined">campaign</span>
            Blogging
          </a>
          <a href="/admin/scoring" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'scoring' ? 'is-active' : '' %>">
            <span class="material-symbols-outlined">trophy</span>
            Scoring
          </a>
          <a href="/admin/settings" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'is-active' : '' %>">
            <span class="material-symbols-outlined">settings</span>
            Settings
          </a>
          <% if (typeof session !== 'undefined' && session.role === 'super') { %>
            <a href="/admin/settings/admins" class="admin-nav-link <%= typeof activePage !== 'undefined' && activePage === 'admins' ? 'is-active' : '' %>">
              <span class="material-symbols-outlined">shield_person</span>
              Admins
            </a>
          <% } %>
        </nav>

        <div class="mt-auto p-4 lg:p-5 border-t-4 border-primary/70">
          <div class="bg-background text-on-surface brutal-border-sm p-4">
            <p class="font-mono text-[10px] font-black uppercase text-primary tracking-widest">Signed in</p>
            <p class="mt-1 truncate font-heading text-lg font-black uppercase"><%= session.username %></p>
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a href="/" class="admin-side-action" aria-label="Open public site">
                <span class="material-symbols-outlined">public</span>
              </a>
              <a href="/logout" class="admin-side-action admin-side-action--danger" aria-label="Logout">
                <span class="material-symbols-outlined">logout</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <main class="admin-main min-w-0 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
