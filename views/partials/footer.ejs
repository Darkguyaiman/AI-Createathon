  <script>
    const eventUrl = window.location.origin;

    document.querySelector('[data-share-event]')?.addEventListener('click', async () => {
      const shareData = {
        title: 'AI Createathon 2026',
        text: 'Join AI Createathon 2026 at Malaysia University of Science and Technology.',
        url: eventUrl
      };

      try {
        if (navigator.share) {
          await navigator.share(shareData);
          return;
        }

        await navigator.clipboard.writeText(shareData.url);
      } catch (error) {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(shareData.url);
        }
      }
    });
  </script>
