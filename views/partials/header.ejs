<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | AI Createathon 2026' : 'AI Createathon 2026 | Prompt Your Ideas' %></title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="AI Createathon 2026: Create an AI-powered application, automation, artwork, or digital solution within 3 hours. Join live voting and follow updates.">
  <meta name="keywords" content="AI Createathon, Malaysia University of Science and Technology, Hackathon, AI coding, public voting">
  <meta name="author" content="AI Createathon Team">

  <!-- App Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  
  <!-- Local vendor fonts & icons -->
  <link rel="stylesheet" href="/vendor/google-fonts/fonts.css">
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  
  <!-- Compiled Tailwind CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Smooth scroll -->
  <script src="/vendor/lenis/lenis.min.js" defer></script>
  <style>
    @media (max-width: 339px) {
      .site-wordmark {
        font-size: 0.85rem;
      }
    }
  </style>
</head>
<body class="bg-background text-on-surface font-sans selection:bg-primary selection:text-white overflow-x-hidden transition-colors duration-300">
  
  <!-- Scrolling Marquee Top -->
  <div class="bg-inverse-surface text-pure-white py-3 marquee brutal-border border-x-0 border-t-0 z-[60] relative">
    <div class="marquee-content marquee-content--top" data-infinite-marquee>
      <span class="font-mono text-xs uppercase flex items-center gap-2"><span class="material-symbols-outlined text-primary">bolt</span> AI CREATEATHON 2026</span>
      <span class="font-mono text-xs uppercase flex items-center gap-2"><span class="material-symbols-outlined text-primary">location_on</span> MALAYSIA UNIVERSITY OF SCIENCE &amp; TECHNOLOGY</span>
      <span class="font-mono text-xs uppercase flex items-center gap-2"><span class="material-symbols-outlined text-primary">calendar_today</span> 8 JULY 2026</span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="sticky top-0 w-full z-50 bg-background brutal-border border-x-0 border-t-0 h-24 flex items-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex items-center justify-between gap-2 min-w-0">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-4 group min-w-0 shrink">
        <div class="bg-primary p-2 brutal-border text-white transform group-hover:rotate-6 transition-transform shrink-0">
          <span class="material-symbols-outlined" style="font-size: 28px; display: block;">smart_toy</span>
        </div>
        <span class="site-wordmark min-w-0 text-[0.95rem] sm:text-2xl lg:text-3xl font-black text-on-surface uppercase tracking-tight font-heading leading-none whitespace-nowrap">AI-<span class="text-primary">CREATEATHON</span></span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center justify-center gap-6 xl:gap-8 font-mono text-[11px] xl:text-sm font-black uppercase min-w-0 flex-1">
        <a class="hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'text-primary underline decoration-4 decoration-primary underline-offset-4' : 'text-on-surface' %>" href="/">HOME</a>
        <a class="hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'updates' ? 'text-primary underline decoration-4 decoration-primary underline-offset-4' : 'text-on-surface' %>" href="/updates">UPDATES</a>
        <a class="hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'voting' ? 'text-primary underline decoration-4 decoration-primary underline-offset-4' : 'text-on-surface' %>" href="/voting">VOTING</a>
        <% if (typeof votingActive !== 'undefined' && votingActive) { %>
          <a class="hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'leaderboard' ? 'text-primary underline decoration-4 decoration-primary underline-offset-4' : 'text-on-surface' %>" href="/leaderboard">LEADERBOARD</a>
        <% } %>
        <a class="hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'team' ? 'text-primary underline decoration-4 decoration-primary underline-offset-4' : 'text-on-surface' %>" href="/team">TEAM</a>
      </div>

      <!-- Desktop actions -->
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <% if (typeof session !== 'undefined' && session.isAdmin) { %>
          <a href="/admin/dashboard" class="inline-flex items-center gap-2 bg-inverse-surface text-pure-white font-mono text-[10px] xl:text-xs px-4 xl:px-6 py-3 brutal-border brutal-shadow-sm active:translate-x-1 active:translate-y-1 active:shadow-none transition-all uppercase font-black whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">dashboard</span>
            DASHBOARD
          </a>
        <% } else { %>
          <a href="/login" class="inline-flex items-center gap-2 bg-primary text-on-primary font-heading text-[10px] xl:text-sm px-4 xl:px-6 py-3 brutal-border brutal-shadow-sm active:translate-x-1 active:translate-y-1 active:shadow-none transition-all uppercase font-black whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">lock</span>
            ADMIN LOGIN
          </a>
        <% } %>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-on-surface border-2 border-on-surface bg-white shadow-brutal-sm hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none transition-all focus:outline-none shrink-0 ml-auto" aria-label="Toggle Menu" aria-controls="mobile-menu" aria-expanded="false" type="button">
        <i class="fa-solid fa-bars text-lg"></i>
      </button>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-menu" class="absolute top-full left-0 w-full z-50 overflow-hidden px-4 sm:px-6 lg:hidden pointer-events-none" aria-hidden="true">
      <div
        id="mobile-menu-panel"
        class="mx-auto max-w-7xl bg-background brutal-border border-x-0 border-t-0 p-5 sm:p-6 pb-8 sm:pb-10 flex flex-col gap-3 font-mono text-sm uppercase shadow-brutal-sm"
        style="max-height: 0px; opacity: 0; transform: translateY(-12px); transition: max-height 280ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);"
      >
        <a class="block py-2 hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'text-primary font-black' : 'text-on-surface' %>" href="/">HOME</a>
        <a class="block py-2 hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'updates' ? 'text-primary font-black' : 'text-on-surface' %>" href="/updates">UPDATES</a>
        <a class="block py-2 hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'voting' ? 'text-primary font-black' : 'text-on-surface' %>" href="/voting">VOTING</a>
        <% if (typeof votingActive !== 'undefined' && votingActive) { %>
          <a class="block py-2 hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'leaderboard' ? 'text-primary font-black' : 'text-on-surface' %>" href="/leaderboard">LEADERBOARD</a>
        <% } %>
        <a class="block py-2 hover:text-primary transition-colors <%= typeof activePage !== 'undefined' && activePage === 'team' ? 'text-primary font-black' : 'text-on-surface' %>" href="/team">TEAM</a>
        <a href="/login" class="block text-center bg-primary text-on-primary font-heading text-sm py-3 brutal-border font-black mt-2 mb-1">
          ADMIN LOGIN
        </a>
      </div>
    </div>
  </nav>

  <!-- Interactive script for Mobile Menu -->
  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuPanel = document.getElementById('mobile-menu-panel');
    const menuIcon = mobileMenuBtn?.querySelector('i');
    let mobileMenuOpen = false;

    const syncMobileMenu = (open) => {
      if (!mobileMenu || !mobileMenuPanel || !mobileMenuBtn) return;

      mobileMenuOpen = open;
      mobileMenuBtn.setAttribute('aria-expanded', String(open));
      mobileMenu.setAttribute('aria-hidden', String(!open));
      mobileMenu.style.pointerEvents = open ? 'auto' : 'none';
      mobileMenuPanel.style.maxHeight = open ? `${mobileMenuPanel.scrollHeight + 32}px` : '0px';
      mobileMenuPanel.style.opacity = open ? '1' : '0';
      mobileMenuPanel.style.transform = open ? 'translateY(0)' : 'translateY(-12px)';

      if (menuIcon) {
        menuIcon.className = open ? 'fa-solid fa-xmark text-lg' : 'fa-solid fa-bars text-lg';
      }
    };

    mobileMenuBtn?.addEventListener('click', () => {
      syncMobileMenu(!mobileMenuOpen);
    });

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => syncMobileMenu(false));
    });

    document.addEventListener('click', event => {
      if (!mobileMenuOpen) return;
      if (mobileMenu?.contains(event.target) || mobileMenuBtn?.contains(event.target)) return;
      syncMobileMenu(false);
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        syncMobileMenu(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        syncMobileMenu(false);
      }
    });

    // Lightweight scroll-animation registry using IntersectionObserver
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll('[data-infinite-marquee]').forEach(track => {
        const sourceItems = Array.from(track.children).map(item => item.cloneNode(true));
        let resizeTimer;

        const buildMarquee = () => {
          if (!sourceItems.length) return;

          track.style.animation = 'none';
          track.textContent = '';

          const segment = document.createElement('div');
          segment.className = 'marquee-segment';

          const appendSourceItems = () => {
            sourceItems.forEach(item => segment.appendChild(item.cloneNode(true)));
          };

          appendSourceItems();
          track.appendChild(segment);

          let guard = 0;
          while (segment.scrollWidth < window.innerWidth + 96 && guard < 24) {
            appendSourceItems();
            guard += 1;
          }

          track.appendChild(segment.cloneNode(true));
          track.style.animation = '';
        };

        buildMarquee();

        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(buildMarquee, 150);
        });
      });

      if (window.Lenis && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.9,
          touchMultiplier: 1.2
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.05,
        rootMargin: "0px 0px -50px 0px"
      });

      document.querySelectorAll('.fade-up').forEach(el => {
        observer.observe(el);
      });

      const scrollRotators = Array.from(document.querySelectorAll('[data-scroll-motion="rotate"]'));
      const scrollBobbers = Array.from(document.querySelectorAll('[data-scroll-motion="bob"]'));
      if ((scrollRotators.length || scrollBobbers.length) && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let lastScrollY = window.scrollY;
        let rotation = 0;
        let bob = 0;
        let ticking = false;

        const applyScrollMotion = () => {
          scrollRotators.forEach(element => {
            element.style.setProperty('--scroll-rotate', `${rotation}deg`);
          });
          scrollBobbers.forEach(element => {
            element.style.setProperty('--scroll-bob', `${bob}px`);
          });
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          const currentScrollY = window.scrollY;
          const delta = currentScrollY - lastScrollY;
          lastScrollY = currentScrollY;

          rotation = (rotation + delta * 0.035) % 360;
          bob = Math.sin(currentScrollY * 0.025) * 12;

          if (!ticking) {
            window.requestAnimationFrame(applyScrollMotion);
            ticking = true;
          }
        }, { passive: true });
      }

      const qrModal = document.querySelector('[data-qr-modal]');
      const qrOpenButton = document.querySelector('[data-qr-modal-open]');
      const qrCloseButtons = document.querySelectorAll('[data-qr-modal-close]');

      qrOpenButton?.addEventListener('click', () => {
        if (qrModal?.showModal) {
          qrModal.showModal();
        }
      });

      qrCloseButtons.forEach(button => {
        button.addEventListener('click', () => qrModal?.close());
      });

      qrModal?.addEventListener('click', event => {
        if (event.target === qrModal) {
          qrModal.close();
        }
      });

      const darkSections = Array.from(document.querySelectorAll('.dark-scroll-section'));
      if (darkSections.length) {
        const visibleDarkSections = new Set();
        const darkObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              visibleDarkSections.add(entry.target);
            } else {
              visibleDarkSections.delete(entry.target);
            }
          });

          document.body.classList.toggle('dark-page-active', visibleDarkSections.size > 0);
        }, {
          threshold: 0.24,
          rootMargin: "-12% 0px -12% 0px"
        });

        darkSections.forEach(section => darkObserver.observe(section));
      }
    });
  </script>

  <!-- Main Container -->
  <main class="flex-grow">
